@@ -0,0 +1,314 @@
+"""
+SegMASt3R + Sinkhorn matcher adapter for RoboHop's localizer.
+
+Wraps third_party/segmast3r/model_infer.py:MASt3RSegFeatInfer (the paper's
+inference class) and exposes a MatchLightGlue-compatible interface so it can
+be plugged into libs/localizer/loc_topo.py via matcher_name='segmast3r_sinkhorn'.
+
+Differences vs MatchLightGlue (libs/matcher/lightglue.py):
+  - No keypoint extraction. Per-pair MASt3R encode→decode→desc→masked-pool→Sinkhorn
+    yields a (M_src, M_tgt) similarity matrix directly.
+  - No precomputed map features (descriptors are pair-dependent — MASt3R's
+    cross-attention decoder ties view0 desc to its paired view1).
+  - Internal resolution is fixed to MASt3R's 512×512 input. Sim observations
+    (typically 320×240) and node masks are resized internally; node areas are
+    derived from the original masks at sim resolution.
+
+Returned tuple matches MatchLightGlue.matchPair_imgWithMask:
+  (matchesBool, matches_ij, singleBestMatch, lmat_ij, [None, None])
+"""
+
+import os
+import sys
+import logging
+from pathlib import Path
+
+import cv2
+import numpy as np
+import torch
+import torch.nn.functional as F
+from yacs.config import CfgNode as CN
+
+from libs.common import utils
+from libs.logger.level import LOG_LEVEL
+
+logger = logging.getLogger("[SegMASt3R-Sinkhorn]")
+logger.setLevel(LOG_LEVEL)
+
+# ---------------------------------------------------------------------------
+# segmast3r repo lives at <repo_root>/third_party/segmast3r/, but its imports
+# (mast3r_src.*, src.models.*) are written assuming the segmast3r dir IS the
+# project root. So we have to inject it onto sys.path before importing
+# model_infer.
+# ---------------------------------------------------------------------------
+_HERE = Path(__file__).resolve()
+_OBJ_REL_NAV_ROOT = _HERE.parents[2]  # libs/matcher → libs → object-rel-nav
+_REPO_ROOT = _OBJ_REL_NAV_ROOT.parent.parent  # third_party → repo root
+_SEGMAST3R_ROOT = _REPO_ROOT / "third_party" / "segmast3r"
+
+for p in (str(_SEGMAST3R_ROOT), str(_SEGMAST3R_ROOT / "mast3r_src")):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+from model_infer import MASt3RSegFeatInfer  # noqa: E402
+
+# MASt3R input geometry. Paper's `paired_data_interface.py:resize_longest_side`
+# scales the longest image side to 512 and keeps aspect ratio. PatchEmbedDust3R
+# uses patch_size=16, so we then round both dims down to multiples of 16.
+# Our square 512×512 squash was a HIGH-severity bug — distortion broke spatial features.
+_MAST3R_LONGEST = 512
+_MAST3R_PATCH = 16
+
+
+def _aspect_preserve_size(h: int, w: int, longest: int = _MAST3R_LONGEST,
+                          patch: int = _MAST3R_PATCH):
+    """resize_longest_side and round to multiples of patch_size."""
+    scale = longest / max(h, w)
+    new_h = max(patch, round(h * scale / patch) * patch)
+    new_w = max(patch, round(w * scale / patch) * patch)
+    return new_h, new_w
+
+
+def _build_default_cfg():
+    """Minimal CfgNode that satisfies MASt3RSegFeatInfer.__init__."""
+    cfg = CN(new_allowed=True)
+    cfg.DATASET = CN(new_allowed=True)
+    cfg.DATASET.DATA_SOURCE = "hm3d"  # any string — model_infer's branch is buggy-truthy
+    cfg.FEATURE_MATCHER = CN(new_allowed=True)
+    cfg.FEATURE_MATCHER.TYPE = "Sinkhorn"
+    cfg.FEATURE_MATCHER.SINKHORN = CN(new_allowed=True)
+    cfg.FEATURE_MATCHER.SINKHORN.NUM_IT = 50
+    cfg.FEATURE_MATCHER.SINKHORN.DUSTBIN_SCORE_INIT = 1.0
+    cfg.FEATURE_MATCHER.DUAL_SOFTMAX = CN(new_allowed=True)
+    cfg.FEATURE_MATCHER.DUAL_SOFTMAX.TEMPERATURE = 0.1
+    cfg.FEATURE_MATCHER.DUAL_SOFTMAX.USE_DUSTBIN = True
+    return cfg
+
+
+def _load_image_to_mast3r(path_or_arr, target_h, target_w, device):
+    """Read RGB → resize (LINEAR) → normalize to [-1, 1] → CHW float tensor on device."""
+    if isinstance(path_or_arr, (str, Path)):
+        img = cv2.imread(str(path_or_arr))
+        if img is None:
+            raise FileNotFoundError(f"Could not read image: {path_or_arr}")
+        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
+    elif isinstance(path_or_arr, np.ndarray):
+        img = path_or_arr
+        if img.shape[-1] == 4:
+            img = img[..., :3]
+    else:
+        raise TypeError(f"Unsupported input type: {type(path_or_arr)}")
+
+    # INTER_LINEAR matches paper's BILINEAR (PIL) and INTER_LINEAR (cv2 in gradio_app_rr).
+    # INTER_AREA is undefined for upscaling — was a MEDIUM bug.
+    img = cv2.resize(img, (target_w, target_h), interpolation=cv2.INTER_LINEAR)
+    # MASt3R training: T.ToTensor() + T.Normalize((0.5,)*3, (0.5,)*3) ⇒ [-1, 1]
+    img = img.astype(np.float32) / 127.5 - 1.0
+    return torch.from_numpy(img).permute(2, 0, 1).to(device)  # (3, H, W)
+
+
+def _nodes_to_mask_tensor(nodes, target_h, target_w, device):
+    """List[dict] with 'segmentation' (binary HxW) → (M, target_h, target_w) float tensor."""
+    if len(nodes) == 0:
+        return torch.zeros((0, target_h, target_w), dtype=torch.float32, device=device)
+    masks = utils.nodes2key(nodes, "segmentation").astype(bool)  # (M, H_orig, W_orig)
+    if masks.shape[1] != target_h or masks.shape[2] != target_w:
+        masks = masks.transpose(1, 2, 0).astype(np.float32)
+        masks = cv2.resize(masks, (target_w, target_h), interpolation=cv2.INTER_NEAREST)
+        if masks.ndim == 2:
+            masks = masks[..., None]
+        masks = (masks > 0.5).transpose(2, 0, 1)
+    return torch.from_numpy(masks.astype(np.float32)).to(device)
+
+
+class MatchSegMASt3RSinkhorn:
+    """Drop-in replacement for MatchLightGlue using SegMASt3R Sinkhorn matcher.
+
+    Constructor signature mirrors MatchLightGlue so that loc_topo.py's dispatch
+    code stays identical aside from the elif branch.
+
+    Args:
+        resize_w, resize_h: sim observation size (kept for API parity; we always
+            operate at 512×512 internally).
+        device: 'cuda' or 'cpu'.
+        cfg: a dict-like with at least 'checkpoint_path' pointing at the
+            paper's segmast3r_spp.ckpt.
+    """
+
+    def __init__(self, resize_w=320, resize_h=240, device="cuda", cfg=None):
+        self.resize_w = resize_w
+        self.resize_h = resize_h
+        self.device = device
+        self.cfg = cfg or {}
+
+        ckpt_path = self.cfg.get(
+            "checkpoint_path",
+            str(_SEGMAST3R_ROOT / "checkpoints" / "segmast3r_spp.ckpt"),
+        )
+        if not os.path.exists(ckpt_path):
+            raise FileNotFoundError(
+                f"SegMASt3R Sinkhorn checkpoint not found at {ckpt_path}. "
+                "Set goal_gen.checkpoint_path or place it under "
+                "third_party/segmast3r/checkpoints/segmast3r_spp.ckpt."
+            )
+
+        logger.info(f"Loading MASt3RSegFeatInfer from {ckpt_path} on {device}")
+        model_cfg = _build_default_cfg()
+        self.model = MASt3RSegFeatInfer(model_cfg)
+        ckpt = torch.load(ckpt_path, map_location="cpu", weights_only=False)
+        state_dict = ckpt.get("state_dict", ckpt)
+        missing, unexpected = self.model.load_state_dict(state_dict, strict=False)
+        if missing:
+            logger.warning(f"Missing keys when loading ckpt: {len(missing)} (e.g. {missing[:3]})")
+        if unexpected:
+            logger.warning(f"Unexpected keys when loading ckpt: {len(unexpected)} (e.g. {unexpected[:3]})")
+        self.model.prepare(device=device)
+        logger.info("SegMASt3R Sinkhorn matcher ready.")
+
+        # Score threshold default = 0.0 (paper does only mutual-NN, no post-filter).
+        # A non-zero value can be set via cfg for ablation; was 0.05 historically (a bug).
+        self.score_threshold = float(self.cfg.get("score_threshold", 0.0))
+        # Set SEGMAST3R_DEBUG=1 to print per-pair match-stage diagnostics
+        self.debug = bool(int(os.environ.get("SEGMAST3R_DEBUG", "0")))
+        # Cache target H,W per (src_h, src_w) input to avoid recomputing
+        self._size_cache = {}
+
+    # ------------------------------------------------------------------
+    # Helpers
+    # ------------------------------------------------------------------
+    def _resolve_target_size(self, h: int, w: int):
+        key = (h, w)
+        if key not in self._size_cache:
+            self._size_cache[key] = _aspect_preserve_size(h, w)
+        return self._size_cache[key]
+
+    def getImg(self, pathOrArr):
+        """API-compat shim; returns MASt3R-formatted (3, H, W) tensor on device.
+        Uses aspect-preserving resize (longest=512, round to multiples of 16)."""
+        # Need to know source size. Read once to get shape, then resize.
+        if isinstance(pathOrArr, (str, Path)):
+            img = cv2.cvtColor(cv2.imread(str(pathOrArr)), cv2.COLOR_BGR2RGB)
+        else:
+            img = pathOrArr if pathOrArr.shape[-1] == 3 else pathOrArr[..., :3]
+        h, w = img.shape[:2]
+        target_h, target_w = self._resolve_target_size(h, w)
+        return _load_image_to_mast3r(img, target_h, target_w, self.device)
+
+    @torch.no_grad()
+    def _score_pair(self, img_src, img_tgt, masks_src, masks_tgt):
+        """Run MASt3R + Sinkhorn on a single pair.
+
+        Returns:
+            scores_full: (M+1, N+1) tensor — Sinkhorn output including dustbin
+                row/column. Non-dustbin block is scores_full[:M, :N].
+        """
+        img_src = img_src.unsqueeze(0)  # (1, 3, H, W)
+        img_tgt = img_tgt.unsqueeze(0)
+        masks_src = masks_src.unsqueeze(0)  # (1, M, H, W)
+        masks_tgt = masks_tgt.unsqueeze(0)
+
+        H, W = img_src.shape[-2:]
+        true_shape = torch.tensor([[H, W]], dtype=torch.int64, device=self.device)
+        view0 = {"img": img_src, "true_shape": true_shape, "instance": ["src"]}
+        view1 = {"img": img_tgt, "true_shape": true_shape, "instance": ["tgt"]}
+
+        # Encode + decode + desc head — same flow as MASt3RSegFeatInfer.infer_pair.
+        pred0, pred1 = self.model.forward(view0, view1)
+        # pred*['desc'] has shape (B, H, W, 24); model_infer.forward returns the
+        # raw 'desc' tensor. Transpose to (B, D, H, W) for masked pooling.
+        desc0 = pred0.permute(0, 3, 1, 2)
+        desc1 = pred1.permute(0, 3, 1, 2)
+
+        # Lazy import to avoid import-time side effects.
+        from src.models.mast3r_segfeat.diff_masked_pooling import masked_average_pooling
+        agg0 = masked_average_pooling(desc0, masks_src)  # (1, D, M)
+        agg1 = masked_average_pooling(desc1, masks_tgt)  # (1, D, N)
+
+        log_P = self.model.feature_matcher(agg0, agg1)  # (1, M+1, N+1)
+        scores = torch.exp(log_P)  # (1, M+1, N+1)
+        return scores[0]  # (M+1, N+1)
+
+    def _empty_result(self, M_src, M_tgt):
+        matches_bool = np.zeros(M_src, dtype=bool)
+        matches_ij = np.zeros(M_src, dtype=int)
+        lmat_ij = np.zeros((M_src, M_tgt), dtype=np.float32)
+        return matches_bool, matches_ij, 0, lmat_ij, [None, None]
+
+    # ------------------------------------------------------------------
+    # Single-pair matching (MatchLightGlue.matchPair_imgWithMask compat)
+    # ------------------------------------------------------------------
+    def matchPair_imgWithMask(self, imSrc, imTgt, nodesSrc, nodesTgt,
+                              visualize=False, **_unused):
+        M_src, M_tgt = len(nodesSrc), len(nodesTgt)
+        if M_src == 0 or M_tgt == 0:
+            return None
+
+        img_src = self.getImg(imSrc)
+        img_tgt = self.getImg(imTgt)
+        # Mask must match the resized image size for masked_average_pooling
+        target_h, target_w = img_src.shape[-2], img_src.shape[-1]
+        masks_src = _nodes_to_mask_tensor(nodesSrc, target_h, target_w, self.device)
+        masks_tgt = _nodes_to_mask_tensor(nodesTgt, target_h, target_w, self.device)
+
+        scores_full = self._score_pair(img_src, img_tgt, masks_src, masks_tgt)
+        lmat = scores_full[:M_src, :M_tgt].detach().cpu().numpy()  # (M_src, M_tgt)
+
+        # Mirrors MASt3RSegFeatInfer.infer_pair (model_infer.py:167-211): mutual-NN with dustbin.
+        ref_to_target_full = scores_full[:M_src, :].argmax(dim=-1).cpu().numpy()
+        target_to_ref_full = scores_full[:, :M_tgt].argmax(dim=-2).cpu().numpy()
+
+        is_not_dustbin = ref_to_target_full < M_tgt
+        safe_idx = np.clip(ref_to_target_full, 0, M_tgt - 1)
+        reciprocal = target_to_ref_full[safe_idx]
+        is_mutual = reciprocal == np.arange(M_src)
+
+        matchesBool = is_not_dustbin & is_mutual
+
+        if self.debug:
+            score_at = lmat[np.arange(M_src), safe_idx]
+            sys.stderr.write(
+                f"[Sinkhorn] M_src={M_src} M_tgt={M_tgt} "
+                f"img_size={target_h}x{target_w} "
+                f"lmat_max={lmat.max():.3f} mean={lmat.mean():.3f} "
+                f"not_dustbin={int(is_not_dustbin.sum())} "
+                f"mutual={int(is_mutual.sum())} "
+                f"after_threshold={int(matchesBool.sum())} "
+                f"score_at_match_p10={float(np.quantile(score_at, 0.1)):.3f} "
+                f"p50={float(np.quantile(score_at, 0.5)):.3f}\n"
+            )
+
+        if self.score_threshold > 0.0:
+            score_at_match = lmat[np.arange(M_src), safe_idx]
+            matchesBool = matchesBool & (score_at_match >= self.score_threshold)
+        matches_ij = safe_idx
+
+        # Single best (M_src index whose score is highest)
+        if lmat.size > 0 and lmat.max() > 0:
+            singleBestMatch = int(lmat.max(axis=1).argmax())
+        else:
+            singleBestMatch = 0
+
+        return matchesBool, matches_ij, singleBestMatch, lmat, [None, None]
+
+    # ------------------------------------------------------------------
+    # Multi-ref matching (called by loc_topo.localize)
+    # ------------------------------------------------------------------
+    def matchPair_imgWithMask_multi(self, qryImg, refImgList, qryNodes,
+                                    refNodesList, visualize=False, ftTgtList=None,
+                                    **_unused):
+        """Return (matchPairs_per_ref, vizImgs, qry_features=None)."""
+        del ftTgtList  # not supported — MASt3R is pair-dependent
+        matchPairs = []
+        vizImgs = None
+        for refImg, refNodes in zip(refImgList, refNodesList):
+            result = self.matchPair_imgWithMask(qryImg, refImg, qryNodes, refNodes)
+            if result is not None:
+                matchesBool, matches_ij, _, _, _ = result
+                if matchesBool.any():
+                    src_idx = np.argwhere(matchesBool).flatten()
+                    matchPairs.append(np.column_stack([src_idx, matches_ij[src_idx]]))
+                else:
+                    matchPairs.append(np.zeros((0, 2), dtype=int))
+            else:
+                matchPairs.append(np.zeros((0, 2), dtype=int))
+        return matchPairs, vizImgs, None
