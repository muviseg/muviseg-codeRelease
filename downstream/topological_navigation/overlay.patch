+# Topological-mode baseline RoboHop on minival.
+# This is the REAL reference for our 3-matcher comparison: goal_source=topological
+# means SAM segments + matcher.localize drives the pipeline (paper Table 6 setup).
+#
+# Differences vs baseline_robohop_minival.yaml (gt_metric):
+#   - goal_source: 'topological' (was 'gt_metric')
+#   - infer_traversable: False  (skip CLIP; use simulator instances for traversable)
+#   - save_vis: False  (skip per-step jpgs to keep runtime sane; repeat.mp4 still saved)
+#   - plot: False
+
+path_dataset: './data/'
+path_models: ''
+path_results: './out/results/'
+
+start_idx: 0
+step_idx: 1
+end_idx: 12
+
+reverse: False
+task_type: "original"
+use_gt_localization: False  # CRITICAL: force matcher-based localization, not oracle
+env: "sim"
+
+split: "minival"
+threshold_goal_distance: 1.0
+max_start_distance: "hard"
+max_steps: 250
+
+exp_name: "baseline_robohop_minival_topo"
+
+run_list: ''
+path_run: ''
+
+method: 'robohop'
+segmentor: 'fast_sam'
+goal_source: 'topological'  # was 'gt_metric'
+graph_filename: null
+infer_depth: False
+infer_traversable: False  # use sim instance mask (avoid CLIP dep)
+
+log_wandb: False
+log_robot: True
+debug: False
+except_exit: False
+
+plot: False
+save_vis: False
+
+cull_qry_instances: False
+cull_map_instances: False
+
+sim:
+  hfov: 120
+  width: 320
+  height: 240
+  sensor_height: 0.4
+  sensor_height_map: 1.31
+
+goal_gen:
+  textLabels: []
+  map_segmentor_name: "fast_sam"
+  matcher_name: "lightglue"
+  map_matcher_name: "lightglue"
+  geometric_verification: True
+  match_area: False
+  edge_weight_str: "margin"
+  goalNodeIdx: null
+  use_goal_nbrs: True
+  plan_da_nbrs: True
+  preplan_to_goals_only: False
+  rewrite_graph_with_allPathLengths: False
+  loc_radius: 4
+  subsample_ref: 1
+  reloc_rad_add: 2
+  reloc_rad_max: 15
+  min_num_matches: 0
+  do_track: False
+
+controller:
+  config_file: "configs/controller/object_react_controller.yaml"
+  v_min: 0.05
+  v_max: 0.2
+  w_min: -0.3
+  w_max: 0.3
+
+episode_blacklists:
+  # Inherited verbatim from configs/defaults.yaml (upstream RoboHop /
+  # ObjectReact exclusions, defined by the benchmark authors before any
+  # of our runs). Declared explicitly here so the evaluated denominator
+  # is fixed by the run config and cannot change with the evaluator.
+  all_tasks: [
+    'CrMo8WxCyVb_0000016_chair_411_',
+    'LT9Jq6dN3Ea_0000000_tv_monitor_21_',
+    'Nfvxx8J5NCo_0000009_bed_267_',
+    'k1cupFYWXJ6_0000000_sofa_19_',
+    'k1cupFYWXJ6_0000008_chair_594_',
+    'VBzV5z6i1WS_0000000_tv_monitor_43_',
+  ]
+  original: []
+  original_reverse: []
+  alt_goal: []
+  via_alt_goal: []
