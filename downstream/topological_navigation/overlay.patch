index 0000000..e2509ea
--- /dev/null
+++ b/scripts/analyze_table3.py
@@ -0,0 +1,263 @@
+#!/usr/bin/env python
+"""Paired statistical analysis for the closed-loop HM3D navigation table.
+
+Reads the `per_episode_metrics.csv` files written by `evaluate_objecreact.py`
+and reports, for a set of runs evaluated on the SAME episode list:
+
+  * SR / SPL / Soft-SPL with the blacklist applied as a post-hoc choice
+  * pairwise exact McNemar tests on success (paired, discordant pairs only)
+  * paired bootstrap 95% CIs on SPL and Soft-SPL differences
+  * run-to-run spread when the same label appears in several run directories
+
+Why paired tests: every episode is run by every matcher, so the episode's
+intrinsic difficulty is common to all of them. Comparing independent
+proportions throws that pairing away and loses power. McNemar conditions on
+the discordant episodes -- the only ones carrying information about a
+difference -- and the bootstrap resamples per-episode *differences*.
+
+Usage
+-----
+    python scripts/analyze_table3.py out/results/original
+    python scripts/analyze_table3.py out/results/original --no-blacklist
+    python scripts/analyze_table3.py out/results/original \
+        --include lgv2_minival_Ss16 --include sinkhorn_minival_Ss16
+"""
+
+import argparse
+import csv
+import math
+import re
+from collections import defaultdict
+from pathlib import Path
+
+import numpy as np
+import yaml
+
+TS_PATTERN = re.compile(r"^\d{8}-\d{2}-\d{2}-\d{2}_.+")
+
+
+# ---------------------------------------------------------------- loading
+
+
+def load_blacklist(configs_dir: Path, task_type: str = "original"):
+    """Pre-registered exclusions, inherited from upstream configs/defaults.yaml."""
+    with open(configs_dir / "defaults.yaml") as fh:
+        bl = yaml.safe_load(fh)["episode_blacklists"]
+    return set(bl["all_tasks"]) | set(bl.get(task_type) or [])
+
+
+def find_runs(root: Path, after: str = None, before: str = None):
+    """Map run label -> list of per_episode_metrics.csv (one per repeat).
+
+    `after`/`before` filter on the YYYYMMDD prefix of the run directory. Runs of
+    the same config made with different code are NOT repeats of each other, and
+    they live under the same label, so restricting by date is how you keep a
+    variance estimate honest.
+    """
+    runs = defaultdict(list)
+    for csv_path in sorted(root.rglob("per_episode_metrics.csv")):
+        ts_dir = csv_path.parent
+        if not TS_PATTERN.match(ts_dir.name):
+            continue
+        day = ts_dir.name[:8]
+        if after and day < after:
+            continue
+        if before and day > before:
+            continue
+        # <label>/<split>/<start_difficulty>/<timestamp>/per_episode_metrics.csv
+        label = ts_dir.parents[2].name
+        runs[label].append(csv_path)
+    return runs
+
+
+def read_rows(csv_path: Path):
+    with open(csv_path) as fh:
+        return list(csv.DictReader(fh))
+
+
+def episode_table(csv_paths, blacklist):
+    """Merge repeats of one label -> {episode_id: [row, ...]}."""
+    per_ep = defaultdict(list)
+    for path in csv_paths:
+        for row in read_rows(path):
+            if row["episode_id"] in blacklist:
+                continue
+            per_ep[row["episode_id"]].append(
+                {
+                    "success": int(row["success"]),
+                    "spl": float(row["spl"]),
+                    "soft_spl": float(row["soft_spl"]),
+                    "steps": int(row["steps"]),
+                    "status": row["status"],
+                    "scene": row["scene"],
+                }
+            )
+    return per_ep
+
+
+# ---------------------------------------------------------------- statistics
+
+
+def binom_two_sided(k, n, p=0.5):
+    """Exact two-sided binomial test, no scipy dependency."""
+    if n == 0:
+        return 1.0
+    probs = [math.comb(n, i) * p**i * (1 - p) ** (n - i) for i in range(n + 1)]
+    observed = probs[k]
+    # sum probabilities of outcomes no more likely than the observed one
+    return min(1.0, sum(pr for pr in probs if pr <= observed + 1e-12))
+
+
+def mcnemar(succ_a, succ_b):
+    """Exact McNemar on paired success vectors. Returns (b, c, p)."""
+    b = int(np.sum((succ_a == 1) & (succ_b == 0)))  # A wins
+    c = int(np.sum((succ_a == 0) & (succ_b == 1)))  # B wins
+    return b, c, binom_two_sided(min(b, c), b + c)
+
+
+def paired_bootstrap(x, y, n_boot=10000, seed=0):
+    """95% CI for mean(x - y) by resampling episodes (not values)."""
+    rng = np.random.default_rng(seed)
+    d = x - y
+    n = len(d)
+    if n == 0:
+        return 0.0, (0.0, 0.0)
+    idx = rng.integers(0, n, size=(n_boot, n))
+    means = d[idx].mean(axis=1)
+    return float(d.mean()), (
+        float(np.percentile(means, 2.5)),
+        float(np.percentile(means, 97.5)),
+    )
+
+
+# ---------------------------------------------------------------- reporting
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("root", type=Path, help="dir to scan for per_episode_metrics.csv")
+    ap.add_argument("--configs", type=Path, default=Path("configs"))
+    ap.add_argument("--task-type", default="original")
+    ap.add_argument(
+        "--no-blacklist",
+        action="store_true",
+        help="evaluate on every episode present (denominator = all runs)",
+    )
+    ap.add_argument(
+        "--include",
+        action="append",
+        default=None,
+        help="run label to include; repeatable. Default: all labels found.",
+    )
+    ap.add_argument("--exclude-viz", action="store_true", default=True)
+    ap.add_argument("--no-exclude-viz", dest="exclude_viz", action="store_false")
+    ap.add_argument("--n-boot", type=int, default=10000)
+    ap.add_argument("--after", default=None, metavar="YYYYMMDD",
+                    help="only runs on/after this date (same config + different "
+                         "code are not repeats)")
+    ap.add_argument("--before", default=None, metavar="YYYYMMDD")
+    args = ap.parse_args()
+
+    blacklist = set() if args.no_blacklist else load_blacklist(
+        args.configs, args.task_type
+    )
+    runs = find_runs(args.root, after=args.after, before=args.before)
+    if args.exclude_viz:
+        runs = {k: v for k, v in runs.items() if not k.startswith(("viz_", "viz2_"))}
+    if args.include:
+        runs = {k: v for k, v in runs.items() if k in set(args.include)}
+    if not runs:
+        raise SystemExit(f"No per_episode_metrics.csv found under {args.root}")
+
+    tables = {label: episode_table(paths, blacklist) for label, paths in runs.items()}
+
+    print(f"\nBlacklist: {'DISABLED' if args.no_blacklist else f'{len(blacklist)} episodes'}")
+    print(f"Runs found: {len(tables)}\n")
+
+    # Several timestamp dirs under one label are NOT automatically repeats of the
+    # same code -- an adapter edited between two runs makes them different
+    # experiments. Print the provenance so this is checkable, not assumed.
+    for label, paths in sorted(runs.items()):
+        if len(paths) > 1:
+            print(f"NOTE  {label}: {len(paths)} run dirs treated as repeats -- "
+                  f"verify the code was unchanged between them:")
+            for pth in paths:
+                print(f"        {pth.parent.name}")
+    if any(len(v) > 1 for v in runs.values()):
+        print()
+
+    # ---- per-run summary, averaging repeats within a label
+    print("=" * 96)
+    print(f"{'run':38s} {'eps':>4s} {'rep':>4s} {'SR %':>7s} {'SPL':>7s} {'sSPL':>7s} {'SR spread':>11s}")
+    print("=" * 96)
+    summary = {}
+    for label, per_ep in sorted(tables.items()):
+        eps = sorted(per_ep)
+        if not eps:
+            continue
+        n_rep = max(len(v) for v in per_ep.values())
+        # first repeat = headline numbers; extra repeats feed the spread column
+        sr, spl, ssp = [], [], []
+        for r in range(n_rep):
+            got = [per_ep[e][r] for e in eps if len(per_ep[e]) > r]
+            if len(got) != len(eps):
+                continue
+            sr.append(np.mean([g["success"] for g in got]) * 100)
+            spl.append(np.mean([g["spl"] for g in got]) * 100)
+            ssp.append(np.mean([g["soft_spl"] for g in got]) * 100)
+        if not sr:
+            continue
+        spread = f"{min(sr):.1f}-{max(sr):.1f}" if len(sr) > 1 else "-"
+        print(f"{label[:37]:38s} {len(eps):4d} {len(sr):4d} {sr[0]:7.2f} {spl[0]:7.2f} {ssp[0]:7.2f} {spread:>11s}")
+        summary[label] = {
+            "episodes": eps,
+            "success": np.array([per_ep[e][0]["success"] for e in eps]),
+            "spl": np.array([per_ep[e][0]["spl"] for e in eps]),
+            "soft_spl": np.array([per_ep[e][0]["soft_spl"] for e in eps]),
+            "sr_repeats": sr,
+        }
+
+    # ---- run-to-run variance
+    multi = {k: v for k, v in summary.items() if len(v["sr_repeats"]) > 1}
+    if multi:
+        print("\n" + "=" * 96)
+        print("RUN-TO-RUN SPREAD (same config, repeated)")
+        print("=" * 96)
+        for label, v in sorted(multi.items()):
+            reps = v["sr_repeats"]
+            print(f"{label[:37]:38s} SR over {len(reps)} repeats: "
+                  f"{', '.join(f'{r:.1f}' for r in reps)}  "
+                  f"(range {max(reps)-min(reps):.1f} pts)")
+
+    # ---- pairwise paired comparisons on the common episode set
+    labels = sorted(summary)
+    if len(labels) < 2:
+        return
+    print("\n" + "=" * 96)
+    print("PAIRWISE, PAIRED (common episodes only)")
+    print("=" * 96)
+    print(f"{'A vs B':52s} {'n':>3s} {'McNemar b/c':>12s} {'p':>7s} {'dSPL [95% CI]':>24s}")
+    print("-" * 96)
+    for i, a in enumerate(labels):
+        for b in labels[i + 1:]:
+            common = sorted(set(summary[a]["episodes"]) & set(summary[b]["episodes"]))
+            if len(common) < 2:
+                continue
+            ia = [summary[a]["episodes"].index(e) for e in common]
+            ib = [summary[b]["episodes"].index(e) for e in common]
+            sa, sb = summary[a]["success"][ia], summary[b]["success"][ib]
+            pa, pb = summary[a]["spl"][ia] * 100, summary[b]["spl"][ib] * 100
+            nb, nc, p = mcnemar(sa, sb)
+            d, (lo, hi) = paired_bootstrap(pa, pb, n_boot=args.n_boot)
+            star = " *" if p < 0.05 else ""
+            name = f"{a[:24]} vs {b[:24]}"
+            print(f"{name:52s} {len(common):3d} {f'{nb}/{nc}':>12s} {p:7.3f} "
+                  f"{f'{d:+.2f} [{lo:+.2f},{hi:+.2f}]':>24s}{star}")
+
+    print("\nMcNemar b/c = episodes where only A succeeded / only B succeeded.")
+    print("dSPL = mean per-episode SPL(A) - SPL(B), paired bootstrap CI.")
+    print("* marks p < 0.05 (uncorrected; with many rows, adjust for multiplicity).")
+
+
+if __name__ == "__main__":
+    main()
