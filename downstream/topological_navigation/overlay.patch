diff --git a/finalize_pairwise_dpt.sh b/finalize_pairwise_dpt.sh
new file mode 100644
index 0000000..8f1f879
--- /dev/null
+++ b/finalize_pairwise_dpt.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+# Merge the 3 preserved episodes (indices 0,1,2) with the 9 resume episodes
+# (indices 3..11) into one folder, then compute SR / SPL / Soft-SPL over all 12.
+# Run AFTER the resume run prints RESUME_DONE.
+set -u
+cd "$(dirname "$0")"
+MAMBA="/mnt/vol0/home/dennis/miniforge3/bin/mamba"
+
+KEEP=out/results/original/_pairwise_keep_eps012
+MERGED=out/results/original/_pairwise_merged/minival/hard/20260703-00-00-00_robohop_topological
+rm -rf out/results/original/_pairwise_merged
+mkdir -p "$MERGED"
+
+# 1) copy the 3 preserved episodes (0,1,2)
+cp -r "$KEEP"/*__robohop_topological "$MERGED"/ 2>/dev/null
+
+# 2) copy the 9 resume episodes (3..11) from the latest resume run dir
+resume_dir=$(ls -dt out/results/original/segvggt_dpt_minival_Ss16/minival/hard/2026* | head -1)
+echo "resume_dir=$resume_dir"
+for d in "$resume_dir"/*__robohop_topological; do
+  [ -d "$d" ] || continue
+  cp -r "$d" "$MERGED"/ 2>/dev/null
+done
+
+echo "=== merged episode count (expect 12) ==="
+ls -d "$MERGED"/*__robohop_topological 2>/dev/null | wc -l
+echo "=== per-episode statuses ==="
+for m in "$MERGED"/*/metadata.txt; do
+  ep=$(basename "$(dirname "$m")" | sed 's/__robohop_topological//')
+  st=$(grep -h success_status "$m" | cut -d= -f2)
+  printf "%-42s %s\n" "$ep" "$st"
+done
+
+echo
+echo "=== SR / SPL / Soft-SPL over all 12 (10 after blacklist) ==="
+"$MAMBA" run -n nav python scripts/evaluate_objecreact.py "out/results/original/_pairwise_merged"
