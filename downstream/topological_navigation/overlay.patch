@@ -0,0 +1,306 @@
+"""
+SegVGGT-DPT-Joint matcher adapter for RoboHop.
+
+Wraps training/models/vggt_dpt_lg.py:SegVGGTDPTJoint (our trained matcher with
+VGGT Aggregator backbone + DPT-style multi-layer fusion + joint multi-frame
+self-attention + DoubleSoftmax matcher).
+
+Differences from MASt3R-based adapters:
+  - Backbone: VGGT (not MASt3R). Different image preprocessing —
+    extract_multi_layer expects [-1, 1] then internally rescales to [0, 1].
+    We pass [-1, 1] (same as MASt3R) for consistency.
+  - Calls forward_multiframe with N=2 per query-ref pair. The joint attention
+    runs over all segments from both frames at once.
+
+Returned tuple matches MatchLightGlue:
+  (matchesBool, matches_ij, singleBestMatch, lmat_ij, [None, None])
+"""
+
+import os
+import sys
+import logging
+from pathlib import Path
+
+import cv2
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from libs.common import utils
+from libs.logger.level import LOG_LEVEL
+
+logger = logging.getLogger("[SegVGGT-DPT-Joint]")
+logger.setLevel(LOG_LEVEL)
+
+_HERE = Path(__file__).resolve()
+_OBJ_REL_NAV_ROOT = _HERE.parents[2]
+_REPO_ROOT = _OBJ_REL_NAV_ROOT.parent.parent
+_VGGT_ROOT = _REPO_ROOT / "third_party" / "vggt"
+
+# Add only the muviseg repo root. Do NOT add third_party/vggt: it ships its own
+# top-level `training/` package, which used to shadow this project's when both
+# were on sys.path. The VGGT Aggregator is reached through
+# muviseg.models.vggt_dpt_lg -> setup_vggt_path(), which handles that path itself.
+if str(_REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(_REPO_ROOT))
+
+from muviseg.models.vggt_dpt_lg import SegVGGTDPTJoint  # noqa: E402
+
+# VGGT preprocessing: aspect-preserving resize, longest=518, multiple of patch=14.
+# Same fix as Sinkhorn/LGv2 adapters — square 518×518 squashed our HM3D 320×240.
+_VGGT_LONGEST = 518
+_VGGT_PATCH = 14
+
+
+def _aspect_preserve_size(h: int, w: int, longest: int = _VGGT_LONGEST,
+                          patch: int = _VGGT_PATCH):
+    scale = longest / max(h, w)
+    return (max(patch, round(h * scale / patch) * patch),
+            max(patch, round(w * scale / patch) * patch))
+
+_DEFAULT_VGGT_CKPT = _REPO_ROOT / "third_party" / "vggt_weights.pt"
+_DEFAULT_JOINT_CKPT = _REPO_ROOT / "results" / "segvggt_dpt" / "joint-001" / "best.pth"
+
+
+def _load_image_for_vggt(path_or_arr, target_h, target_w, device):
+    """Load image, resize aspect-preserving (LINEAR), normalize to [-1, 1]."""
+    if isinstance(path_or_arr, (str, Path)):
+        img = cv2.imread(str(path_or_arr))
+        if img is None:
+            raise FileNotFoundError(f"Could not read image: {path_or_arr}")
+        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
+    elif isinstance(path_or_arr, np.ndarray):
+        img = path_or_arr
+        if img.shape[-1] == 4:
+            img = img[..., :3]
+    else:
+        raise TypeError(f"Unsupported input type: {type(path_or_arr)}")
+    img = cv2.resize(img, (target_w, target_h), interpolation=cv2.INTER_LINEAR)
+    img = img.astype(np.float32) / 127.5 - 1.0
+    return torch.from_numpy(img).permute(2, 0, 1).to(device)
+
+
+def _nodes_to_mask_tensor(nodes, target_h, target_w, device):
+    if len(nodes) == 0:
+        return torch.zeros((0, target_h, target_w), dtype=torch.float32, device=device)
+    masks = utils.nodes2key(nodes, "segmentation").astype(bool)
+    if masks.shape[1] != target_h or masks.shape[2] != target_w:
+        masks = masks.transpose(1, 2, 0).astype(np.float32)
+        masks = cv2.resize(masks, (target_w, target_h), interpolation=cv2.INTER_NEAREST)
+        if masks.ndim == 2:
+            masks = masks[..., None]
+        masks = (masks > 0.5).transpose(2, 0, 1)
+    return torch.from_numpy(masks.astype(np.float32)).to(device)
+
+
+class MatchSegVGGTDPTJoint:
+    """SegVGGT-DPT-Joint matcher, MatchLightGlue-compatible.
+
+    Args:
+        resize_w, resize_h: kept for API parity (unused — internal 518×518).
+        device: 'cuda' or 'cpu'.
+        cfg: dict with optional 'joint_checkpoint_path', 'vggt_ckpt_path',
+            'match_threshold' (default 0.05), 'n_joint_layers' (default 3).
+    """
+
+    def __init__(self, resize_w=320, resize_h=240, device="cuda", cfg=None):
+        self.resize_w = resize_w
+        self.resize_h = resize_h
+        self.device = device
+        self.cfg = cfg or {}
+
+        vggt_ckpt = self.cfg.get("vggt_ckpt_path", str(_DEFAULT_VGGT_CKPT))
+        joint_ckpt = self.cfg.get("joint_checkpoint_path", str(_DEFAULT_JOINT_CKPT))
+        for p, name in [(vggt_ckpt, "VGGT backbone"), (joint_ckpt, "Joint head")]:
+            if not os.path.exists(p):
+                raise FileNotFoundError(f"{name} checkpoint not found at {p}")
+
+        logger.info(f"Building SegVGGTDPTJoint (vggt={vggt_ckpt}) on {device}")
+        self.model = SegVGGTDPTJoint(
+            vggt_ckpt=vggt_ckpt,
+            layer_indices=(5, 11, 17, 23),
+            fusion_dim=256,
+            proj_dim=128,
+            n_joint_layers=int(self.cfg.get("n_joint_layers", 3)),
+            n_heads=4,
+            ffn_expansion=4,
+            max_frames=16,
+            device=device,
+        )
+
+        logger.info(f"Loading Joint head weights from {joint_ckpt}")
+        ckpt = torch.load(joint_ckpt, map_location="cpu", weights_only=False)
+        state_dict = ckpt.get("model_state", ckpt.get("state_dict", ckpt))
+        missing, unexpected = self.model.load_state_dict(state_dict, strict=False)
+        if missing:
+            logger.warning(f"Missing keys: {len(missing)} (e.g. {missing[:3]})")
+        if unexpected:
+            logger.warning(f"Unexpected keys: {len(unexpected)} (e.g. {unexpected[:3]})")
+
+        self.model.eval().to(device)
+        self.match_threshold = float(self.cfg.get("match_threshold", 0.0))
+
+        # Frames per joint forward: query + (n-1) map frames matched in ONE pass
+        # of joint attention. The model was trained at N_FRAMES=4
+        # (training/config/segvggt_dpt_train_joint.yaml:53), so 4 is the
+        # training regime; 2 reduces the joint model to a pairwise one.
+        # frame_embed is (16, 128) but only rows 0-3 ever received gradient,
+        # so n > 4 uses untrained frame embeddings.
+        self.n_frames = int(self.cfg.get("joint_n_frames", 2))
+        if not 2 <= self.n_frames <= 16:
+            raise ValueError(f"joint_n_frames must be in [2, 16], got {self.n_frames}")
+        if self.n_frames > 4:
+            logger.warning(
+                f"joint_n_frames={self.n_frames} > 4: frame_embed rows 4+ are at "
+                "initialisation (never trained). Exploratory only.")
+
+        # The DoubleSoftmax head also predicts per-segment matchability, which
+        # the project's own pairwise evaluation uses as a reject option
+        # (muviseg/evaluation/model_infer.py:17 -> `match0 > 0`). It is OFF by
+        # default here so this adapter reproduces its historical behaviour;
+        # turn it on with `use_matchability: true` to match the paper protocol.
+        self.use_matchability = bool(self.cfg.get("use_matchability", False))
+
+        self.debug = bool(int(os.environ.get("SEGMAST3R_DEBUG", "0")))
+        self._size_cache = {}
+        logger.info(
+            f"SegVGGT-DPT-Joint matcher ready "
+            f"(n_frames={self.n_frames}, matchability_gate={self.use_matchability}).")
+
+    def _resolve_target_size(self, h: int, w: int):
+        key = (h, w)
+        if key not in self._size_cache:
+            self._size_cache[key] = _aspect_preserve_size(h, w)
+        return self._size_cache[key]
+
+    def getImg(self, pathOrArr, target_hw=None):
+        """Image tensor. `target_hw` forces a size so a multi-frame stack is uniform."""
+        if isinstance(pathOrArr, (str, Path)):
+            img = cv2.cvtColor(cv2.imread(str(pathOrArr)), cv2.COLOR_BGR2RGB)
+        else:
+            img = pathOrArr if pathOrArr.shape[-1] == 3 else pathOrArr[..., :3]
+        if target_hw is None:
+            h, w = img.shape[:2]
+            target_h, target_w = self._resolve_target_size(h, w)
+        else:
+            target_h, target_w = target_hw
+        return _load_image_for_vggt(img, target_h, target_w, self.device)
+
+    @torch.no_grad()
+    def _score_group(self, img_qry, imgs_ref, masks_qry, masks_refs):
+        """One joint forward over (query + len(imgs_ref)) frames.
+
+        Joint attention runs over the segments of ALL frames in the stack at
+        once -- that is the point of the joint model, so the number of map
+        frames per forward is what `joint_n_frames` controls.
+
+        Returns {k: (log_mutual, match0, match1)} for k = 1..len(imgs_ref),
+        where k indexes into imgs_ref offset by one (frame 0 is the query).
+        Frames with no segments are kept in the stack -- dropping them would
+        shift every later frame index -- but no pair is requested for them.
+        """
+        images = torch.stack([img_qry, *imgs_ref], dim=0).unsqueeze(0)
+        masks_list = [masks_qry.unsqueeze(0)] + [m.unsqueeze(0) for m in masks_refs]
+        pair_indices = [
+            (0, k) for k, m in enumerate(masks_refs, start=1) if m.shape[0] > 0
+        ]
+        if not pair_indices:
+            return {}
+        results = self.model.forward_multiframe(
+            images=images, masks_list=masks_list, pair_indices=pair_indices,
+        )
+        return {k: tuple(t[0] for t in results[(0, k)]) for (_, k) in pair_indices}
+
+    def _matches_from_scores(self, log_mutual, match0, M_src):
+        """Mutual-NN (+ optional matchability gate) -> (matchesBool, matches_ij, scores)."""
+        scores = torch.exp(log_mutual).detach().cpu().numpy()  # (M, N)
+        matches_ij = scores.argmax(axis=1)
+        target_to_src = scores.argmax(axis=0)
+        is_mutual = target_to_src[matches_ij] == np.arange(M_src)
+        matchesBool = is_mutual
+
+        if self.use_matchability and match0 is not None:
+            matchesBool = matchesBool & (match0.detach().cpu().numpy() > 0)
+
+        if self.match_threshold > 0.0:
+            score_at_match = scores[np.arange(M_src), matches_ij]
+            matchesBool = matchesBool & (score_at_match >= self.match_threshold)
+
+        return matchesBool, matches_ij, scores
+
+    def matchPair_imgWithMask(self, imSrc, imTgt, nodesSrc, nodesTgt,
+                              visualize=False, **_unused):
+        M_src, M_tgt = len(nodesSrc), len(nodesTgt)
+        if M_src == 0 or M_tgt == 0:
+            return None
+
+        img_src = self.getImg(imSrc)
+        target_hw = (img_src.shape[-2], img_src.shape[-1])
+        img_tgt = self.getImg(imTgt, target_hw)
+        masks_src = _nodes_to_mask_tensor(nodesSrc, *target_hw, self.device)
+        masks_tgt = _nodes_to_mask_tensor(nodesTgt, *target_hw, self.device)
+
+        out = self._score_group(img_src, [img_tgt], masks_src, [masks_tgt])
+        if 1 not in out:
+            return None
+        log_mutual, match0, _match1 = out[1]
+        matchesBool, matches_ij, scores = self._matches_from_scores(
+            log_mutual, match0, M_src)
+
+        if self.debug:
+            score_at = scores[np.arange(M_src), matches_ij]
+            sys.stderr.write(
+                f"[VGGT-Joint] M_src={M_src} M_tgt={M_tgt} img_size={target_hw} "
+                f"scores_max={scores.max():.3f} mean={scores.mean():.3f} "
+                f"matched={int(matchesBool.sum())} "
+                f"score_at_match_p50={float(np.quantile(score_at, 0.5)):.3f}\n"
+            )
+
+        singleBestMatch = (
+            int(scores.max(axis=1).argmax()) if scores.size > 0 else 0
+        )
+        return matchesBool, matches_ij, singleBestMatch, scores, [None, None]
+
+    def matchPair_imgWithMask_multi(self, qryImg, refImgList, qryNodes,
+                                    refNodesList, visualize=False, ftTgtList=None,
+                                    **_unused):
+        """Match the query against every reference, joint over chunks of frames.
+
+        Contract (libs/localizer/loc_topo.py:171-172): return one (K, 2) array
+        per reference image, in the SAME order as refImgList.
+        """
+        del ftTgtList
+        M_src = len(qryNodes)
+        empty = np.zeros((0, 2), dtype=int)
+        if M_src == 0 or len(refImgList) == 0:
+            return [empty.copy() for _ in refImgList], None, None
+
+        # One size for the whole stack: torch.stack would fail on a frame of a
+        # different size, and the query must not be re-resized per reference.
+        img_qry = self.getImg(qryImg)
+        target_hw = (img_qry.shape[-2], img_qry.shape[-1])
+        masks_qry = _nodes_to_mask_tensor(qryNodes, *target_hw, self.device)
+
+        matchPairs = [empty.copy() for _ in refImgList]
+        refs_per_forward = max(1, self.n_frames - 1)
+
+        for start in range(0, len(refImgList), refs_per_forward):
+            chunk = list(range(start, min(start + refs_per_forward, len(refImgList))))
+            imgs_ref = [self.getImg(refImgList[i], target_hw) for i in chunk]
+            masks_refs = [
+                _nodes_to_mask_tensor(refNodesList[i], *target_hw, self.device)
+                for i in chunk
+            ]
+            out = self._score_group(img_qry, imgs_ref, masks_qry, masks_refs)
+            for k, ref_pos in enumerate(chunk, start=1):
+                if k not in out:
+                    continue
+                log_mutual, match0, _ = out[k]
+                matchesBool, matches_ij, _ = self._matches_from_scores(
+                    log_mutual, match0, M_src)
+                if matchesBool.any():
+                    src_idx = np.argwhere(matchesBool).flatten()
+                    matchPairs[ref_pos] = np.column_stack(
+                        [src_idx, matches_ij[src_idx]])
+
+        return matchPairs, None, None
