+                "shortest_path_length": round(shortest_path_length, 6),
+            }
+        )
+
     if len(episode_dirs) == num_ignored:
         print("WARNING: Run only contains ignored episodes")
         continue
 
     denom = len(episode_dirs) - num_ignored  # len(episode_names_ignore)
 
+    if args.per_episode_csv and per_episode_rows:
+        out_csv = results_dir / "per_episode_metrics.csv"
+        fieldnames = list(per_episode_rows[0].keys())
+        with open(out_csv, "w", newline="") as fh:
+            writer = csv.DictWriter(fh, fieldnames=fieldnames)
+            writer.writeheader()
+            writer.writerows(per_episode_rows)
+        if verbose:
+            print(f"Wrote {len(per_episode_rows)} per-episode rows -> {out_csv}")
+
     if verbose:
         print(f"[{num_success/denom*100:.2f}%] {num_success=} of {denom} episodes")
         print(f"[{num_exceeded/denom*100:.2f}%] {num_exceeded=} of {denom} episodes")
