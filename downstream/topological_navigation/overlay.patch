diff --git a/scripts/start_window_analysis.py b/scripts/start_window_analysis.py
new file mode 100644
index 0000000..f39be01
--- /dev/null
+++ b/scripts/start_window_analysis.py
@@ -0,0 +1,167 @@
+#!/usr/bin/env python
+"""Does the episode's start pose fall inside the localizer's initial window?
+
+`max_start_distance: hard` places the agent at the teach waypoint roughly 5 m
+(geodesic) from the goal -- i.e. mid-trajectory -- while `LocalizeTopological`
+cold-starts at `localizedImgIdx = 0`, so its first search window is
+`[0, 2*loc_radius)` (libs/localizer/loc_topo.py:82,105-111). An episode whose
+start waypoint lies outside that window cannot be localized correctly on the
+first steps, and the agent locks onto the wrong end of the map.
+
+This script reports, per episode, the true start waypoint and whether it is
+inside the window -- so the confound can be quantified BEFORE looking at
+success rates, and so `init_localization` can be verified to remove it.
+
+It needs Habitat only for the navmesh pathfinder (no rendering), and reuses
+`task_setup.select_starting_state` so the answer reflects what the runs
+actually do rather than a re-implementation.
+
+Usage
+-----
+    python scripts/start_window_analysis.py                       # minival
+    python scripts/start_window_analysis.py --split val --loc-radius 8
+    python scripts/start_window_analysis.py --csv start_windows.csv
+"""
+
+import argparse
+import csv
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+import numpy as np
+from natsort import natsorted
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from libs.common import utils  # noqa: E402
+from libs.experiments import task_setup  # noqa: E402
+
+
+class _Args:
+    """Minimal stand-in for the argparse namespace select_starting_state reads."""
+
+    def __init__(self, max_start_distance, task_type, reverse):
+        self.max_start_distance = max_start_distance
+        self.task_type = task_type
+        self.reverse = reverse
+
+
+def _start_index(sim, sa, agent_states):
+    """Start waypoint index, mirroring task_setup.select_starting_state.
+
+    That function returns an AgentState rather than the index, so its threshold
+    dispatch is mirrored here; the geodesic search itself is the shared
+    `task_setup.closest_state`, so the numbers cannot drift apart.
+    """
+    offset = 1 if sa.reverse else 0
+    mode = sa.max_start_distance.lower()
+    if mode == "easy":
+        return task_setup.closest_state(sim, agent_states, 3 + offset)
+    if mode == "hard":
+        if sa.task_type == "via_alt_goal":
+            offset += 3
+        return task_setup.closest_state(sim, agent_states, 5 + offset)
+    if mode == "full":
+        return 0 if not sa.reverse else len(agent_states) - 1
+    raise NotImplementedError(f"max_start_distance: {sa.max_start_distance}")
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--data", type=Path, default=Path("./data"))
+    ap.add_argument("--split", default="minival")
+    ap.add_argument("--loc-radius", type=int, default=8,
+                    help="goal_gen.loc_radius; window width is 2*loc_radius")
+    ap.add_argument("--max-start-distance", default="hard")
+    ap.add_argument("--task-type", default="original")
+    ap.add_argument("--reverse", action="store_true")
+    ap.add_argument("--csv", type=Path, default=None)
+    args = ap.parse_args()
+
+    ep_root = args.data / f"hm3d_iin_{args.split}"
+    scenes_root = args.data / "hm3d_v0.2" / args.split
+    if not ep_root.exists():
+        raise SystemExit(f"No episodes at {ep_root}")
+    if not scenes_root.exists():
+        raise SystemExit(
+            f"No scene assets at {scenes_root}. The Habitat + semantic-annots "
+            f"tars for split '{args.split}' have to be extracted there first.")
+
+    episodes = natsorted([d for d in ep_root.iterdir() if d.is_dir()])
+    window = 2 * args.loc_radius
+    sa = _Args(args.max_start_distance, args.task_type, args.reverse)
+
+    # group by scene so each scene's simulator is built once
+    by_scene = defaultdict(list)
+    for ep in episodes:
+        by_scene[ep.name.split("_")[0]].append(ep)
+
+    rows, skipped = [], []
+    for scene_id, eps in sorted(by_scene.items()):
+        matches = sorted(scenes_root.glob(f"*{scene_id}"))
+        if not matches:
+            skipped.extend((ep, "scene assets missing") for ep in eps)
+            continue
+        glbs = sorted(matches[0].glob("*basis.glb"))
+        if not glbs:
+            skipped.extend((ep, "no *basis.glb") for ep in eps)
+            continue
+
+        sim, _agent, _actions = utils.get_sim_agent(str(glbs[0]), updateNavMesh=False)
+        try:
+            for ep in eps:
+                states_path = ep / "agent_states.npy"
+                if not states_path.exists():
+                    skipped.append((ep, "no agent_states.npy"))
+                    continue
+                agent_states = np.load(str(states_path), allow_pickle=True)
+                start_idx = _start_index(sim, sa, agent_states)
+                rows.append(
+                    {
+                        "episode_id": ep.name,
+                        "scene": scene_id,
+                        "n_teach": len(agent_states),
+                        "start_waypoint": int(start_idx),
+                        "window_lo": 0,
+                        "window_hi": window,
+                        "inside_window": int(start_idx < window),
+                    }
+                )
+        finally:
+            sim.close()
+
+    if not rows:
+        raise SystemExit("No episodes could be analysed (scene assets missing?)")
+
+    inside = sum(r["inside_window"] for r in rows)
+    print(f"\nsplit={args.split}  loc_radius={args.loc_radius}  "
+          f"window=[0,{window})  max_start_distance={args.max_start_distance}\n")
+    print(f"{'episode':44s} {'nTeach':>7s} {'start':>6s} {'inside':>7s}")
+    print("-" * 68)
+    for r in rows:
+        flag = "yes" if r["inside_window"] else "NO"
+        print(f"{r['episode_id'][:43]:44s} {r['n_teach']:7d} "
+              f"{r['start_waypoint']:6d} {flag:>7s}")
+    print("-" * 68)
+    print(f"{inside}/{len(rows)} episodes start inside the initial window "
+          f"({100*inside/len(rows):.0f}%)")
+    if inside < len(rows):
+        print(f"\n{len(rows)-inside} episode(s) cannot be localized from the cold "
+              f"start with init_localization: 'zero'. Use 'global' (default) so "
+              f"the first frame is matched against the whole map.")
+    if skipped:
+        print(f"\nskipped {len(skipped)}:")
+        for ep, why in skipped[:10]:
+            print(f"   {ep.name}: {why}")
+
+    if args.csv:
+        with open(args.csv, "w", newline="") as fh:
+            w = csv.DictWriter(fh, fieldnames=list(rows[0].keys()))
+            w.writeheader()
+            w.writerows(rows)
+        print(f"\nwrote {args.csv}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/summarize_matchers.py b/scripts/summarize_matchers.py
new file mode 100644
index 0000000..44602fe
--- /dev/null
+++ b/scripts/summarize_matchers.py
@@ -0,0 +1,132 @@
+"""
+Aggregate SPL/SSPL/Success across multiple run dirs into one comparison table.
+
+Usage:
+    python scripts/summarize_matchers.py [run_glob_or_dir] [...]
+
+Defaults to scanning all RoboHop runs under out/results/original/<exp>/minival/hard/
+that have at least one episode result. Emits markdown.
+"""
+
+import argparse
+import glob
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+
+def latest_run(exp_root: Path) -> Path | None:
+    candidates = sorted(exp_root.glob("2026-*"), key=lambda p: p.name, reverse=True)
+    if not candidates:
+        # Pattern shipped is YYYYMMDD-HH-MM-SS_<...>; sort accordingly
+        candidates = sorted(exp_root.glob("*_robohop_*"), key=lambda p: p.name, reverse=True)
+    return candidates[0] if candidates else None
+
+
+def parse_eval(run_dir: Path) -> dict:
+    """Run evaluate_objecreact.py and parse the SPL/SSPL line."""
+    script = Path(__file__).parent / "evaluate_objecreact.py"
+    cmd = [
+        "/mnt/vol0/home/dennis/miniforge3/bin/mamba",
+        "run",
+        "-n",
+        "nav",
+        "python",
+        str(script),
+        str(run_dir.relative_to(Path.cwd())) if run_dir.is_relative_to(Path.cwd()) else str(run_dir),
+    ]
+    try:
+        out = subprocess.run(cmd, capture_output=True, text=True, timeout=60).stdout
+    except Exception as e:
+        return {"error": str(e)}
+
+    res = {"run_dir": str(run_dir)}
+    m = re.search(r"num_success=(\d+) of (\d+)", out)
+    if m:
+        res["num_success"] = int(m.group(1))
+        res["num_total"] = int(m.group(2))
+        res["success_rate"] = res["num_success"] / max(1, res["num_total"]) * 100
+    m = re.search(r"Mean SPL of Success Runs:\s*([\d.]+)", out)
+    if m:
+        res["mean_spl"] = float(m.group(1))
+    m = re.search(r"Mean Soft SPL:\s*([\d.]+)", out)
+    if m:
+        res["mean_soft_spl"] = float(m.group(1))
+    m = re.search(r"num_exceeded=(\d+)", out)
+    if m:
+        res["num_exceeded"] = int(m.group(1))
+    m = re.search(r"num_errors=(\d+)", out)
+    if m:
+        res["num_errors"] = int(m.group(1))
+    return res
+
+
+def get_matcher_from_args(run_dir: Path) -> str:
+    args_yaml = run_dir / "args.yaml"
+    if not args_yaml.exists():
+        return "?"
+    txt = args_yaml.read_text()
+    # Match the exact line `  matcher_name: VALUE`, NOT `  map_matcher_name: ...`
+    m = re.search(r"^\s+matcher_name:\s*(\S+)", txt, re.MULTILINE)
+    return m.group(1).strip("\"'") if m else "?"
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("paths", nargs="*", help="Run directories or experiment names. Default: all known.")
+    args = p.parse_args()
+
+    repo = Path(__file__).resolve().parent.parent  # object-rel-nav
+    os.chdir(repo)
+
+    if not args.paths:
+        # Default: all unique experiment dirs under out/results/original/
+        roots = sorted(Path("out/results/original").glob("*"))
+        run_dirs = []
+        for exp in roots:
+            for split in exp.glob("*"):
+                for diff in split.glob("*"):
+                    latest = latest_run(diff)
+                    if latest is not None:
+                        run_dirs.append(latest)
+    else:
+        run_dirs = []
+        for p_str in args.paths:
+            p_path = Path(p_str)
+            if p_path.is_dir():
+                run_dirs.append(p_path)
+            else:
+                # treat as experiment name glob
+                for d in glob.glob(f"out/results/original/{p_str}/*/*"):
+                    latest = latest_run(Path(d))
+                    if latest is not None:
+                        run_dirs.append(latest)
+
+    rows = []
