+++ b/libs/matcher/roma_seg.py
@@ -0,0 +1,190 @@
+"""RoMa dense matcher -> segment-level correspondences by majority vote.
+
+A modern dense-matching baseline for the closed-loop table. RoMa (Edstedt et al.)
+produces a dense warp between two images; we sample pixel correspondences from
+it and aggregate them into segment matches with the SAME vote used by the
+SuperPoint+LightGlue adapter (`libs/matcher/lightglue.py:49-57` and `:91-103`):
+
+    lmat_ij = (node2kp1[:, None] * node2kp2[None, :]).sum(-1)   # (M, N) votes
+    matches_ij = lmat_ij.argmax(1)
+
+Keeping the aggregation identical is deliberate -- the only thing that differs
+from the LightGlue row is where the pixel correspondences come from, so the
+comparison isolates the matcher rather than the voting scheme.
+
+Notes
+-----
+* No map-feature caching. RoMa's decoder is pairwise (the warp for image A
+  depends on B), so per-image precompute is invalid, exactly as for the MASt3R
+  adapters -- see `libs/localizer/loc_topo.py:50-51`.
+* `upsample_preds` is disabled by default: RoMa's upsampling stage targets
+  ~(864, 1152), which is far above the 320x240 simulator frames here, so it
+  costs time without adding usable precision. Set `roma_upsample: true` in
+  `goal_gen` to restore stock behaviour.
+
+Returned tuple matches MatchLightGlue.matchPair_imgWithMask:
+  (matchesBool, matches_ij, singleBestMatch, lmat_ij, [None, None])
+"""
+
+import logging
+
+import cv2
+import numpy as np
+import torch
+from PIL import Image
+
+from libs.common import utils
+from libs.logger.level import LOG_LEVEL
+
+logger = logging.getLogger("[RoMa]")
+logger.setLevel(LOG_LEVEL)
+
+
+class MatchRoMaSeg:
+    """Drop-in matcher for loc_topo, mirroring MatchLightGlue's interface.
+
+    Args:
+        resize_w, resize_h: frame size the map masks are defined in.
+        device: 'cuda' or 'cpu'.
+        cfg: goal_gen block. Recognised keys:
+            roma_variant     'indoor' (default) | 'outdoor'
+            roma_num_samples number of sampled correspondences (default 5000)
+            roma_certainty   minimum certainty to keep a sample (default 0.0)
+            roma_upsample    run RoMa's high-res refinement (default False)
+            match_area       area-consistency gate, as in MatchLightGlue
+    """
+
+    def __init__(self, resize_w=320, resize_h=240, device="cuda", cfg=None):
+        self.device = device
+        self.resize_w = resize_w
+        self.resize_h = resize_h
+        self.cfg = cfg or {}
+        self.match_area = self.cfg.get("match_area", False)
+
+        self.num_samples = int(self.cfg.get("roma_num_samples", 5000))
+        self.certainty_threshold = float(self.cfg.get("roma_certainty", 0.0))
+        variant = str(self.cfg.get("roma_variant", "indoor")).lower()
+
+        from romatch import roma_indoor, roma_outdoor  # noqa: E402
+
+        logger.info(f"Building RoMa ({variant}) on {device}")
+        builder = roma_indoor if variant == "indoor" else roma_outdoor
+        self.model = builder(device=device)
+        self.model.upsample_preds = bool(self.cfg.get("roma_upsample", False))
+        logger.info(
+            f"RoMa matcher ready (samples={self.num_samples}, "
+            f"certainty>={self.certainty_threshold}, upsample={self.model.upsample_preds})"
+        )
+
+    # ------------------------------------------------------------------
+    # Helpers
+    # ------------------------------------------------------------------
+    def getImg(self, pathOrArr):
+        """RoMa consumes PIL images; keep everything at (resize_h, resize_w)."""
+        if isinstance(pathOrArr, str):
+            img = Image.open(pathOrArr).convert("RGB")
+        else:
+            arr = pathOrArr
+            if arr.shape[-1] == 4:
+                arr = arr[..., :3]
+            img = Image.fromarray(arr.astype(np.uint8)).convert("RGB")
+        if img.size != (self.resize_w, self.resize_h):
+            img = img.resize((self.resize_w, self.resize_h), Image.BILINEAR)
+        return img
+
+    def map_node2kp(self, kp, nodeInds):
+        """Pixel -> segment membership. Copied from MatchLightGlue.map_node2kp."""
+        masks = utils.nodes2key(nodeInds, "segmentation")
+        areas = utils.nodes2key(nodeInds, "area")
+        if masks.shape[1] != self.resize_h or masks.shape[2] != self.resize_w:
+            masks = cv2.resize(
+                masks.transpose(1, 2, 0).astype(float),
+                (self.resize_w, self.resize_h),
+                interpolation=cv2.INTER_NEAREST,
+            ).astype(bool)
+            masks = masks.transpose(2, 0, 1)
+        m = masks[:, kp[:, 1].astype(int), kp[:, 0].astype(int)]
+        return m, areas
+
+    @torch.no_grad()
+    def _dense_correspondences(self, imgA, imgB):
+        """(K, 2) pixel coords in A and in B, sampled from RoMa's dense warp."""
+        warp, certainty = self.model.match(imgA, imgB, device=self.device)
+        matches, conf = self.model.sample(warp, certainty, num=self.num_samples)
+        if self.certainty_threshold > 0.0:
+            keep = conf >= self.certainty_threshold
+            matches = matches[keep]
+        if matches.shape[0] == 0:
+            return np.zeros((0, 2)), np.zeros((0, 2))
+        kA, kB = self.model.to_pixel_coordinates(
+            matches, self.resize_h, self.resize_w, self.resize_h, self.resize_w
+        )
+        kA = kA.detach().cpu().numpy()
+        kB = kB.detach().cpu().numpy()
+        # to_pixel_coordinates can land exactly on the upper bound; clip so the
+        # mask lookup in map_node2kp stays in range.
+        kA[:, 0] = np.clip(kA[:, 0], 0, self.resize_w - 1)
+        kA[:, 1] = np.clip(kA[:, 1], 0, self.resize_h - 1)
+        kB[:, 0] = np.clip(kB[:, 0], 0, self.resize_w - 1)
+        kB[:, 1] = np.clip(kB[:, 1], 0, self.resize_h - 1)
+        return kA, kB
+
+    # ------------------------------------------------------------------
+    # Single-pair matching
+    # ------------------------------------------------------------------
+    def matchPair_imgWithMask(self, imSrc, imTgt, nodesSrc, nodesTgt,
+                              visualize=False, **_unused):
+        if len(nodesSrc) == 0 or len(nodesTgt) == 0:
+            return None
+
+        mkp1, mkp2 = self._dense_correspondences(self.getImg(imSrc), self.getImg(imTgt))
+        if len(mkp1) == 0:
+            return None
+
+        node2kp1, areas1 = self.map_node2kp(mkp1, nodesSrc)
+        node2kp2, areas2 = self.map_node2kp(mkp2, nodesTgt)
+
+        # Vote count: how many sampled correspondences link segment i to segment j.
+        lmat_ij = (node2kp1[:, None] * node2kp2[None,]).sum(-1)
+        matchesBool_lfm = lmat_ij.sum(1) != 0
+
+        if self.match_area:
+            areaDiff_ij = areas1[:, None].astype(float) / areas2[None, :]
+            areaDiff_ij[areaDiff_ij > 1] = 1 / areaDiff_ij[areaDiff_ij > 1]
+            lmat_ij = lmat_ij * areaDiff_ij
+
+        matches_ij = lmat_ij.argmax(1)
+
+        if self.match_area:
+            matchesBool_area = (
+                areaDiff_ij[np.arange(len(matches_ij)), matches_ij] > 0.5
+            )
+            matchesBool = np.logical_and(matchesBool_lfm, matchesBool_area)
+        else:
+            matchesBool = matchesBool_lfm
+
+        singleBestMatch = int(lmat_ij.max(1).argmax())
+        return matchesBool, matches_ij, singleBestMatch, lmat_ij, [None, None]
+
+    # ------------------------------------------------------------------
+    # Multi-ref matching (called by loc_topo.localize)
+    # ------------------------------------------------------------------
+    def matchPair_imgWithMask_multi(self, qryImg, refImgList, qryNodes,
+                                    refNodesList, visualize=False, ftTgtList=None,
+                                    **_unused):
+        del ftTgtList  # not supported -- RoMa's decoder is pairwise
+        matchPairs = []
+        for refImg, refNodes in zip(refImgList, refNodesList):
+            result = self.matchPair_imgWithMask(qryImg, refImg, qryNodes, refNodes)
+            if result is not None:
+                matchesBool, matches_ij, _, _, _ = result
+                if matchesBool.any():
+                    src_idx = np.argwhere(matchesBool).flatten()
+                    matchPairs.append(
+                        np.column_stack([src_idx, matches_ij[src_idx]])
+                    )
+                else:
+                    matchPairs.append(np.zeros((0, 2), dtype=int))
+            else:
+                matchPairs.append(np.zeros((0, 2), dtype=int))
+        return matchPairs, None, None
