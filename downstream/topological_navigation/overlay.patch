+"""
+SegVGGT-DPT (pairwise) matcher adapter for RoboHop.
+
+Wraps training/models/vggt_dpt_lg.py:SegVGGTDPT — our trained matcher with the
+VGGT Aggregator backbone + DPT-style multi-layer fusion + PAIRWISE segment
+cross-attention (SegmentAttentionLayerV2) + DoubleSoftmax matcher.
+
+This is the pairwise sibling of libs/matcher/segvggt_dpt_joint.py. The ONLY
+differences are:
+  - Model class: SegVGGTDPT (pairwise attn_layers) instead of SegVGGTDPTJoint
+    (joint self-attention). Same DoubleSoftmax head, same descriptor pipeline.
+  - Checkpoint: results/segvggt_dpt/v3-001/best.pth (the pairwise run that
+    produced the Replica/VKITTI2 "SegVGGT-DPT" table rows) instead of
+    results/segvggt_dpt/joint-001/best.pth.
+  - Constructor: n_layers (pairwise refinement layers) instead of the joint
+    model's n_joint_layers / max_frames.
+
+The base class forward_multiframe() returns the SAME structure
+  dict {(a, b): (log_mutual, match0, match1)}
+so the scoring path is identical to the joint adapter.
+
+Returned tuple matches MatchLightGlue:
+  (matchesBool, matches_ij, singleBestMatch, lmat_ij, [None, None])
+"""
+
+import os
+import sys
+import logging
+from pathlib import Path
+
+import cv2
+import numpy as np
+import torch
+
+from libs.common import utils
+from libs.logger.level import LOG_LEVEL
+
+logger = logging.getLogger("[SegVGGT-DPT]")
+logger.setLevel(LOG_LEVEL)
+
+_HERE = Path(__file__).resolve()
+_OBJ_REL_NAV_ROOT = _HERE.parents[2]
+_REPO_ROOT = _OBJ_REL_NAV_ROOT.parent.parent
+
+# Add only the muviseg repo root. Do NOT add third_party/vggt: it ships its own
+# top-level `training/` package, which used to shadow this project's when both
+# were on sys.path. The VGGT Aggregator is reached through
+# muviseg.models.vggt_dpt_lg -> setup_vggt_path(), which handles that path itself.
+if str(_REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(_REPO_ROOT))
+
+from muviseg.models.vggt_dpt_lg import SegVGGTDPT  # noqa: E402
+
+# VGGT preprocessing: aspect-preserving resize, longest=518, multiple of patch=14.
+_VGGT_LONGEST = 518
+_VGGT_PATCH = 14
+
+
+def _aspect_preserve_size(h: int, w: int, longest: int = _VGGT_LONGEST,
+                          patch: int = _VGGT_PATCH):
+    scale = longest / max(h, w)
+    return (max(patch, round(h * scale / patch) * patch),
+            max(patch, round(w * scale / patch) * patch))
+
+
+_DEFAULT_VGGT_CKPT = _REPO_ROOT / "third_party" / "vggt_weights.pt"
+_DEFAULT_PAIRWISE_CKPT = _REPO_ROOT / "results" / "segvggt_dpt" / "v3-001" / "best.pth"
+
+
+def _load_image_for_vggt(path_or_arr, target_h, target_w, device):
+    """Load image, resize aspect-preserving (LINEAR), normalize to [-1, 1]."""
+    if isinstance(path_or_arr, (str, Path)):
+        img = cv2.imread(str(path_or_arr))
+        if img is None:
+            raise FileNotFoundError(f"Could not read image: {path_or_arr}")
+        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
+    elif isinstance(path_or_arr, np.ndarray):
+        img = path_or_arr
+        if img.shape[-1] == 4:
+            img = img[..., :3]
+    else:
+        raise TypeError(f"Unsupported input type: {type(path_or_arr)}")
+    img = cv2.resize(img, (target_w, target_h), interpolation=cv2.INTER_LINEAR)
+    img = img.astype(np.float32) / 127.5 - 1.0
+    return torch.from_numpy(img).permute(2, 0, 1).to(device)
+
+
+def _nodes_to_mask_tensor(nodes, target_h, target_w, device):
+    if len(nodes) == 0:
+        return torch.zeros((0, target_h, target_w), dtype=torch.float32, device=device)
+    masks = utils.nodes2key(nodes, "segmentation").astype(bool)
+    if masks.shape[1] != target_h or masks.shape[2] != target_w:
+        masks = masks.transpose(1, 2, 0).astype(np.float32)
+        masks = cv2.resize(masks, (target_w, target_h), interpolation=cv2.INTER_NEAREST)
+        if masks.ndim == 2:
+            masks = masks[..., None]
+        masks = (masks > 0.5).transpose(2, 0, 1)
+    return torch.from_numpy(masks.astype(np.float32)).to(device)
+
+
+class MatchSegVGGTDPT:
+    """SegVGGT-DPT (pairwise) matcher, MatchLightGlue-compatible.
+
+    Args:
+        resize_w, resize_h: kept for API parity (unused — internal 518-longest).
+        device: 'cuda' or 'cpu'.
+        cfg: dict with optional 'pairwise_checkpoint_path', 'vggt_ckpt_path',
+            'match_threshold' (default 0.0), 'n_layers' (default 3).
+    """
+
+    def __init__(self, resize_w=320, resize_h=240, device="cuda", cfg=None):
+        self.resize_w = resize_w
+        self.resize_h = resize_h
+        self.device = device
+        self.cfg = cfg or {}
+
+        vggt_ckpt = self.cfg.get("vggt_ckpt_path", str(_DEFAULT_VGGT_CKPT))
+        pw_ckpt = self.cfg.get("pairwise_checkpoint_path", str(_DEFAULT_PAIRWISE_CKPT))
+        for p, name in [(vggt_ckpt, "VGGT backbone"), (pw_ckpt, "Pairwise head")]:
+            if not os.path.exists(p):
+                raise FileNotFoundError(f"{name} checkpoint not found at {p}")
+
+        logger.info(f"Building SegVGGTDPT (vggt={vggt_ckpt}) on {device}")
+        self.model = SegVGGTDPT(
+            vggt_ckpt=vggt_ckpt,
+            layer_indices=(5, 11, 17, 23),
+            fusion_dim=256,
+            proj_dim=128,
+            n_layers=int(self.cfg.get("n_layers", 3)),
+            n_heads=4,
+            ffn_expansion=4,
+            device=device,
+        )
+
+        logger.info(f"Loading pairwise head weights from {pw_ckpt}")
+        ckpt = torch.load(pw_ckpt, map_location="cpu", weights_only=False)
+        state_dict = ckpt.get("model_state", ckpt.get("state_dict", ckpt))
+        missing, unexpected = self.model.load_state_dict(state_dict, strict=False)
+        if missing:
+            logger.warning(f"Missing keys: {len(missing)} (e.g. {missing[:3]})")
+        if unexpected:
+            logger.warning(f"Unexpected keys: {len(unexpected)} (e.g. {unexpected[:3]})")
+
+        self.model.eval().to(device)
+        self.match_threshold = float(self.cfg.get("match_threshold", 0.0))
+        self.debug = bool(int(os.environ.get("SEGMAST3R_DEBUG", "0")))
+        self._size_cache = {}
+        logger.info("SegVGGT-DPT (pairwise) matcher ready.")
+
+    def _resolve_target_size(self, h: int, w: int):
+        key = (h, w)
+        if key not in self._size_cache:
+            self._size_cache[key] = _aspect_preserve_size(h, w)
+        return self._size_cache[key]
+
+    def getImg(self, pathOrArr):
+        if isinstance(pathOrArr, (str, Path)):
+            img = cv2.cvtColor(cv2.imread(str(pathOrArr)), cv2.COLOR_BGR2RGB)
+        else:
+            img = pathOrArr if pathOrArr.shape[-1] == 3 else pathOrArr[..., :3]
+        h, w = img.shape[:2]
+        target_h, target_w = self._resolve_target_size(h, w)
+        return _load_image_for_vggt(img, target_h, target_w, self.device)
+
+    @torch.no_grad()
+    def _score_pair(self, img_qry, img_ref, masks_qry, masks_ref):
+        """N=2 forward_multiframe, single (0, 1) pair."""
+        images = torch.stack([img_qry, img_ref], dim=0).unsqueeze(0)  # (1, 2, 3, H, W)
+        masks_list = [
+            masks_qry.unsqueeze(0),  # (1, M, H, W)
+            masks_ref.unsqueeze(0),  # (1, N, H, W)
+        ]
+        results = self.model.forward_multiframe(
+            images=images, masks_list=masks_list, pair_indices=[(0, 1)],
+        )
+        log_mutual, match0, match1 = results[(0, 1)]
+        return log_mutual[0], match0[0], match1[0]
+
+    def matchPair_imgWithMask(self, imSrc, imTgt, nodesSrc, nodesTgt,
+                              visualize=False, **_unused):
+        M_src, M_tgt = len(nodesSrc), len(nodesTgt)
+        if M_src == 0 or M_tgt == 0:
+            return None
+
+        img_src = self.getImg(imSrc)
+        img_tgt = self.getImg(imTgt)
+        target_h, target_w = img_src.shape[-2], img_src.shape[-1]
+        masks_src = _nodes_to_mask_tensor(nodesSrc, target_h, target_w, self.device)
+        masks_tgt = _nodes_to_mask_tensor(nodesTgt, target_h, target_w, self.device)
+
+        log_mutual, _match0, _match1 = self._score_pair(
+            img_src, img_tgt, masks_src, masks_tgt
+        )
+        scores = torch.exp(log_mutual).detach().cpu().numpy()  # (M, N)
+
+        matches_ij = scores.argmax(axis=1)
+        target_to_src = scores.argmax(axis=0)
+        is_mutual = target_to_src[matches_ij] == np.arange(M_src)
+        matchesBool = is_mutual
+
+        if self.debug:
+            score_at = scores[np.arange(M_src), matches_ij]
+            sys.stderr.write(
+                f"[VGGT-DPT] M_src={M_src} M_tgt={M_tgt} img_size={target_h}x{target_w} "
+                f"scores_max={scores.max():.3f} mean={scores.mean():.3f} "
+                f"mutual={int(is_mutual.sum())} "
+                f"score_at_match_p10={float(np.quantile(score_at, 0.1)):.3f} "
+                f"p50={float(np.quantile(score_at, 0.5)):.3f}\n"
+            )
+
+        if self.match_threshold > 0.0:
+            score_at_match = scores[np.arange(M_src), matches_ij]
+            matchesBool = matchesBool & (score_at_match >= self.match_threshold)
+
+        if scores.size > 0 and scores.max() > 0:
+            singleBestMatch = int(scores.max(axis=1).argmax())
+        else:
+            singleBestMatch = 0
+
+        return matchesBool, matches_ij, singleBestMatch, scores, [None, None]
+
+    def matchPair_imgWithMask_multi(self, qryImg, refImgList, qryNodes,
+                                    refNodesList, visualize=False, ftTgtList=None,
+                                    **_unused):
+        del ftTgtList
+        matchPairs = []
+        for refImg, refNodes in zip(refImgList, refNodesList):
+            result = self.matchPair_imgWithMask(qryImg, refImg, qryNodes, refNodes)
+            if result is not None:
+                matchesBool, matches_ij, _, _, _ = result
+                if matchesBool.any():
+                    src_idx = np.argwhere(matchesBool).flatten()
+                    matchPairs.append(np.column_stack([src_idx, matches_ij[src_idx]]))
+                else:
+                    matchPairs.append(np.zeros((0, 2), dtype=int))
+            else:
+                matchPairs.append(np.zeros((0, 2), dtype=int))
+        return matchPairs, None, None
