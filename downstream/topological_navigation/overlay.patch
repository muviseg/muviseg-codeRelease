+def plot_trajectory_bev(ax, traj_xz, start_xz, goal_xz, teach_xz=None,
+                        goal_threshold=1.0):
+    """Top-down trajectory view: teach run, executed path, start, goal.
+
+    Args:
+        ax: single matplotlib Axes (e.g. ax[1, 0] of the composite figure)
+        traj_xz: (N, 2) executed path so far in world-XZ (Habitat's ground plane)
+        start_xz: (2,) executed-run start
+        goal_xz: (2,) episode goal position
+        teach_xz: optional (M, 2) teach-run path for reference
+        goal_threshold: radius drawn around goal (= success threshold)
+    """
+    import matplotlib.patches as mpatches
+
+    ax.cla()
+    ax.set_aspect("equal", adjustable="datalim")
+
+    if teach_xz is not None and len(teach_xz) > 0:
+        ax.plot(teach_xz[:, 0], teach_xz[:, 1], "-", color="#888", linewidth=1.0,
+                alpha=0.6, label="teach")
+
+    if traj_xz is not None and len(traj_xz) > 0:
+        traj_xz = np.asarray(traj_xz)
+        ax.plot(traj_xz[:, 0], traj_xz[:, 1], "-", color="#1f77b4", linewidth=1.8,
+                label="agent")
+        # current position marker
+        ax.plot(traj_xz[-1, 0], traj_xz[-1, 1], "o", color="#1f77b4",
+                markersize=6, markeredgecolor="white", markeredgewidth=1)
+
+    if start_xz is not None:
+        ax.plot(start_xz[0], start_xz[1], "*", color="#2ca02c", markersize=14,
+                markeredgecolor="white", markeredgewidth=1, label="start")
+
+    if goal_xz is not None:
+        ax.plot(goal_xz[0], goal_xz[1], "*", color="#d62728", markersize=14,
+                markeredgecolor="white", markeredgewidth=1, label="goal")
+        ax.add_patch(mpatches.Circle((goal_xz[0], goal_xz[1]), goal_threshold,
+                                     fill=False, edgecolor="#d62728",
+                                     linestyle="--", linewidth=1, alpha=0.7))
+
+    ax.set_title("Trajectory (BEV)")
+    ax.tick_params(axis="both", which="both", labelsize=7)
+    ax.legend(loc="best", fontsize=6, framealpha=0.7)
+    ax.grid(True, alpha=0.2)
