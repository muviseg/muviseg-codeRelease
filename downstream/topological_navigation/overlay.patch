@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+# Overnight RoboHop baseline sweep.
+# 4 (Ss, Sρ) cells × 12 minival episodes ≈ 40-60 min total.
+# Run with: bash run_overnight.sh   (will detach via nohup, safe to close terminal)
+
+set -u
+cd "$(dirname "$0")"
+
+LOG_DIR="/tmp/aegis_overnight_$(date +%Y%m%d_%H%M%S)"
+mkdir -p "$LOG_DIR"
+echo "Logs in: $LOG_DIR"
+
+MAMBA="/mnt/vol0/home/dennis/miniforge3/bin/mamba"
+
+run_cell() {
+    local cfg=$1
+    local name=$(basename "$cfg" .yaml)
+    echo "[$(date '+%H:%M:%S')] starting $name" | tee -a "$LOG_DIR/master.log"
+    "$MAMBA" run -n nav python -u main.py -c "$cfg" \
+        > "$LOG_DIR/$name.log" 2>&1
+    local rc=$?
+    echo "[$(date '+%H:%M:%S')] finished $name (exit $rc)" | tee -a "$LOG_DIR/master.log"
+
+    # Eval SPL right after each run completes
+    local run_dir
+    run_dir=$(ls -dt "out/results/original/$name/minival/hard/2026"* 2>/dev/null | head -1)
+    if [ -n "$run_dir" ]; then
+        echo "[$(date '+%H:%M:%S')] eval $name @ $run_dir" | tee -a "$LOG_DIR/master.log"
+        "$MAMBA" run -n nav python scripts/evaluate_objecreact.py "$run_dir" \
+            >> "$LOG_DIR/master.log" 2>&1
+    fi
+    echo "" >> "$LOG_DIR/master.log"
+}
+
+# Sequential — single GPU, one episode at a time inside each run anyway
+run_cell configs/sweep_Ss16_rhoLow.yaml
+run_cell configs/sweep_Ss16_rhoHigh.yaml
+run_cell configs/sweep_Ss32_rhoLow.yaml
+run_cell configs/sweep_Ss32_rhoHigh.yaml
+
+echo "[$(date '+%H:%M:%S')] ALL DONE" | tee -a "$LOG_DIR/master.log"
+echo "Summary: grep -E '(starting|finished|Mean SPL|Soft SPL|Success Rate)' $LOG_DIR/master.log"
