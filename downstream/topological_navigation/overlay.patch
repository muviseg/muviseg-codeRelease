+#!/usr/bin/env bash
+# Run 4 selected episodes × 4 matchers with plot+save_vis enabled.
+# 16 total (matcher, episode_idx) jobs; queues 8 per GPU sequentially.
+set -u
+cd "$(dirname "$0")/.."
+
+EPS=(0 4 6 8)
+MATCHERS=("lightglue" "segmast3r_sinkhorn" "segmast3r_lgv2" "segvggt_dpt_joint")
+LOG_DIR="/tmp/viz_4eps_$(date +%Y%m%d_%H%M%S)"
+mkdir -p "$LOG_DIR"
+echo "Logs in: $LOG_DIR"
+
+CFG_DIR="/tmp/viz_configs_$(date +%Y%m%d_%H%M%S)"
+mkdir -p "$CFG_DIR"
+
+MAMBA="/mnt/vol0/home/dennis/miniforge3/bin/mamba"
+
+write_cfg() {
+    local matcher=$1
+    local ep_idx=$2
+    local out_path=$3
+    cat > "$out_path" <<EOF
+path_dataset: './data/'
+path_models: ''
+path_results: './out/results/'
+start_idx: $ep_idx
+step_idx: 1
+end_idx: $((ep_idx + 1))
+reverse: False
+task_type: "original"
+use_gt_localization: False
+env: "sim"
+split: "minival"
+threshold_goal_distance: 1.0
+max_start_distance: "hard"
+max_steps: 250
+exp_name: "viz2_${matcher}_ep${ep_idx}"
+run_list: ''
+path_run: ''
+method: 'robohop'
+segmentor: 'fast_sam'
+goal_source: 'topological'
+graph_filename: null
+infer_depth: False
+infer_traversable: False
+log_wandb: False
+log_robot: True
+debug: False
+except_exit: False
+plot: True
+save_vis: True
+cull_qry_instances: False
+cull_map_instances: False
+sim:
+  hfov: 120
+  width: 320
+  height: 240
+  sensor_height: 0.4
+  sensor_height_map: 1.31
+goal_gen:
+  textLabels: []
+  map_segmentor_name: "fast_sam"
+  matcher_name: "${matcher}"
+  map_matcher_name: "lightglue"
+  geometric_verification: True
+  match_area: False
+  edge_weight_str: "margin"
+  goalNodeIdx: null
+  use_goal_nbrs: True
+  plan_da_nbrs: True
+  preplan_to_goals_only: False
+  rewrite_graph_with_allPathLengths: False
+  loc_radius: 8
+  subsample_ref: 1
+  reloc_rad_add: 2
+  reloc_rad_max: 15
+  min_num_matches: 0
+  do_track: False
+controller:
+  config_file: "configs/controller/object_react_controller.yaml"
+  v_min: 0.05
+  v_max: 0.2
+  w_min: -0.3
+  w_max: 0.3
+episode_blacklists:
+  all_tasks: []
+  original: []
+  original_reverse: []
+  alt_goal: []
+  via_alt_goal: []
+EOF
+}
+
+run_one() {
+    local matcher=$1
+    local ep_idx=$2
+    local gpu=$3
+    local cfg="$CFG_DIR/viz_${matcher}_ep${ep_idx}.yaml"
+    write_cfg "$matcher" "$ep_idx" "$cfg"
+    local logf="$LOG_DIR/viz_${matcher}_ep${ep_idx}.log"
+    echo "[$(date +%H:%M:%S)] gpu$gpu : start ${matcher} ep${ep_idx}" | tee -a "$LOG_DIR/master.log"
+    CUDA_VISIBLE_DEVICES=$gpu "$MAMBA" run -n nav python -u main.py -c "$cfg" \
+        > "$logf" 2>&1
+    echo "[$(date +%H:%M:%S)] gpu$gpu : done  ${matcher} ep${ep_idx} (exit $?)" | tee -a "$LOG_DIR/master.log"
+}
+
+# Distribute: GPU 0 takes lightglue + LGv2 (lighter); GPU 1 takes Sinkhorn + VGGT.
+# Each GPU runs its 8 jobs sequentially (ep0, ep4, ep6, ep8 × 2 matchers).
+queue_gpu() {
+    local gpu=$1
+    shift
+    for matcher in "$@"; do
+        for ep in "${EPS[@]}"; do
+            run_one "$matcher" "$ep" "$gpu"
+        done
+    done
+}
+
+# GPU 0 is busy with another user's dust3r job (~13 GB). Run everything on
+# GPU 1 (RTX 5090, ~32 GB free) sequentially. ~2.5-3h total.
+queue_gpu 1 "lightglue" "segmast3r_sinkhorn" "segmast3r_lgv2" "segvggt_dpt_joint"
+echo "[$(date +%H:%M:%S)] ALL DONE" | tee -a "$LOG_DIR/master.log"
