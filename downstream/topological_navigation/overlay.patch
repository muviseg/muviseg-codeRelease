+++ b/scripts/jpgs_to_mp4.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# Stitch per-step jpgs in vis/ into mp4 for each viz_* run.
+# Output: <episode_dir>/vis_composite.mp4 (alongside repeat.mp4).
+set -u
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+
+FPS="${FPS:-10}"
+
+found=0; skipped=0; ok=0
+for vis_dir in out/results/original/viz_*/minival/hard/2026*/*_robohop_topological/vis; do
+    [ -d "$vis_dir" ] || continue
+    n=$(ls "$vis_dir"/*.jpg 2>/dev/null | wc -l)
+    if [ "$n" -eq 0 ]; then
+        skipped=$((skipped + 1))
+        continue
+    fi
+    found=$((found + 1))
+    ep_dir=$(dirname "$vis_dir")
+    out_mp4="$ep_dir/vis_composite.mp4"
+    if [ -f "$out_mp4" ]; then
+        echo "[skip] exists: $out_mp4"
+        ok=$((ok + 1))
+        continue
+    fi
+    echo "[mk] $out_mp4 ($n frames)"
+    ffmpeg -loglevel error -y -framerate "$FPS" -i "$vis_dir/%04d.jpg" \
+        -c:v libx264 -pix_fmt yuv420p -vf "pad=ceil(iw/2)*2:ceil(ih/2)*2" \
+        "$out_mp4" 2>&1 | tail -2
+    ok=$((ok + 1))
+done
+echo "Found $found vis dirs, $ok produced, $skipped empty"
