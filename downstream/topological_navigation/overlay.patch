diff --git a/configs/baseline_robohop_minival.yaml b/configs/baseline_robohop_minival.yaml
new file mode 100644
index 0000000..bf2dff5
--- /dev/null
+++ b/configs/baseline_robohop_minival.yaml
@@ -0,0 +1,96 @@
+# Baseline RoboHop on minival: SuperPoint+LightGlue matcher, 12 episodes, full visualization.
+# Reference numbers for comparison vs our 3 checkpoints (Sinkhorn / LGv2 / VGGT-DPT-Joint).
+
+path_dataset: './data/'
+path_models: ''
+path_results: './out/results/'
+
+# All 12 minival episodes
+start_idx: 0
+step_idx: 1
+end_idx: 12
+
+reverse: False
+task_type: "original"
+use_gt_localization: True
+env: "sim"
+
+split: "minival"
+threshold_goal_distance: 1.0
+max_start_distance: "hard"
+max_steps: 250
+
+exp_name: "baseline_robohop_minival"
+
+run_list: ''
+path_run: ''
+
+method: 'robohop'
+segmentor: 'fast_sam'
+goal_source: 'gt_metric'
+graph_filename: null
+infer_depth: False
+infer_traversable: False
+
+log_wandb: False
+log_robot: True
+debug: False
+except_exit: False  # don't crash on first episode failure — collect stats over 12
+
+plot: True       # enable per-step visualization
+save_vis: True   # save composite jpgs into <episode>/vis/
+
+cull_qry_instances: False
+cull_map_instances: False
+
+sim:
+  hfov: 120
+  width: 320
+  height: 240
+  sensor_height: 0.4
+  sensor_height_map: 1.31
+
+goal_gen:
+  textLabels: []
+  map_segmentor_name: "fast_sam"
+  matcher_name: "lightglue"
+  map_matcher_name: "lightglue"
+  geometric_verification: True
+  match_area: False
+  edge_weight_str: "margin"
+  goalNodeIdx: null
+  use_goal_nbrs: True
+  plan_da_nbrs: True
+  preplan_to_goals_only: False
+  rewrite_graph_with_allPathLengths: False
+  loc_radius: 4
+  subsample_ref: 1
+  reloc_rad_add: 2
+  reloc_rad_max: 15
+  min_num_matches: 0
+  do_track: False
+
+controller:
+  config_file: "configs/controller/object_react_controller.yaml"
+  v_min: 0.05
+  v_max: 0.2
+  w_min: -0.3
+  w_max: 0.3
+
+episode_blacklists:
+  # Inherited verbatim from configs/defaults.yaml (upstream RoboHop /
+  # ObjectReact exclusions, defined by the benchmark authors before any
+  # of our runs). Declared explicitly here so the evaluated denominator
+  # is fixed by the run config and cannot change with the evaluator.
+  all_tasks: [
+    'CrMo8WxCyVb_0000016_chair_411_',
+    'LT9Jq6dN3Ea_0000000_tv_monitor_21_',
+    'Nfvxx8J5NCo_0000009_bed_267_',
+    'k1cupFYWXJ6_0000000_sofa_19_',
+    'k1cupFYWXJ6_0000008_chair_594_',
+    'VBzV5z6i1WS_0000000_tv_monitor_43_',
+  ]
+  original: []
+  original_reverse: []
+  alt_goal: []
+  via_alt_goal: []
